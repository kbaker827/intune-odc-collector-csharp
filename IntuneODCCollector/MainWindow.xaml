<Window x:Class="IntuneODCCollector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Intune ODC Log Collector"
        Width="750" Height="620" MinWidth="750" MinHeight="500"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <Menu Grid.Row="0" FontFamily="Segoe UI" FontSize="10">
            <MenuItem Header="_Help">
                <MenuItem Header="Check for _Updates" Click="Menu_CheckForUpdates_Click"/>
                <Separator/>
                <MenuItem Header="_About Intune ODC Collector" Click="Menu_About_Click"/>
            </MenuItem>
        </Menu>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,5">
            <TextBlock Text="Intune ODC Log Collector"
                       FontFamily="Segoe UI" FontSize="16" FontWeight="Bold"/>
            <TextBlock Text="Collect diagnostic logs for Microsoft Intune troubleshooting"
                       FontFamily="Segoe UI" FontSize="9"/>
            <Separator Margin="0,5,0,5"/>
        </StackPanel>

        <!-- What This Tool Does -->
        <GroupBox Grid.Row="1" Header="What This Tool Does" Margin="0,0,0,10" Padding="10">
            <TextBlock FontFamily="Segoe UI" FontSize="9" TextWrapping="Wrap">
                This tool collects Intune One Data Collector (ODC) logs which are used by Microsoft Support to diagnose Intune issues.<LineBreak/><LineBreak/>
                Choose collection method:<LineBreak/>
                • Native C# - Uses built-in collection (recommended, faster)<LineBreak/>
                • Microsoft Tool - Downloads and runs official Microsoft PowerShell script<LineBreak/><LineBreak/>
                The process takes ~10 minutes and creates a compressed ZIP file with all data.<LineBreak/><LineBreak/>
                Note: This tool must be run as Administrator.
            </TextBlock>
        </GroupBox>

        <!-- Collection Mode -->
        <GroupBox Grid.Row="2" Header="Collection Mode" Margin="0,0,0,10" Padding="10">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <RadioButton Content="Native C#"
                                 IsChecked="{Binding UseNativeMode}"
                                 GroupName="Mode" VerticalAlignment="Center"/>
                    <TextBlock Text="(Recommended - Faster, works offline with cached XML)"
                               FontFamily="Segoe UI" FontSize="8" Foreground="Green"
                               Margin="5,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <RadioButton Content="Microsoft Tool"
                                 IsChecked="{Binding UseNativeMode,
                                     Converter={StaticResource InverseBoolConverter}}"
                                 GroupName="Mode" VerticalAlignment="Center"/>
                    <TextBlock Text="(Uses official Microsoft PowerShell script)"
                               FontFamily="Segoe UI" FontSize="8" Foreground="Gray"
                               Margin="5,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <CheckBox Content="Cache Intune.XML locally (faster subsequent runs)"
                          IsChecked="{Binding CacheXml}"
                          Margin="0,5,0,0" FontFamily="Segoe UI" FontSize="9"/>
            </StackPanel>
        </GroupBox>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Start"
                    Command="{Binding StartCommand}"
                    Background="#007bff" Foreground="White"
                    FontFamily="Segoe UI" FontSize="11" FontWeight="Bold"
                    Width="90" Padding="0,6" Margin="0,0,10,0" Cursor="Hand"
                    IsEnabled="{Binding IsRunning,
                        Converter={StaticResource InverseBoolConverter}}"/>
            <Button Content="Open Folder"
                    Command="{Binding OpenFolderCommand}"
                    Background="#6c757d" Foreground="White"
                    FontFamily="Segoe UI" FontSize="10"
                    Width="110" Padding="0,5" Margin="0,0,10,0" Cursor="Hand"/>
            <Button Content="Cancel"
                    Command="{Binding CancelCommand}"
                    Background="#dc3545" Foreground="White"
                    FontFamily="Segoe UI" FontSize="10"
                    Width="90" Padding="0,5" Cursor="Hand"
                    IsEnabled="{Binding IsRunning}"/>
        </StackPanel>

        <!-- Progress -->
        <GroupBox Grid.Row="4" Header="Progress" Margin="0,0,0,10" Padding="10">
            <StackPanel>
                <ProgressBar Value="{Binding ProgressValue}" Maximum="100"
                             Height="18" Margin="0,0,0,5"/>
                <TextBlock Text="{Binding TimeEstimate}"
                           FontFamily="Segoe UI" FontSize="9"/>
                <TextBlock Text="{Binding StatusText}"
                           FontFamily="Segoe UI" FontSize="9" FontWeight="Bold"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </GroupBox>

        <!-- Output -->
        <GroupBox Grid.Row="5" Header="Output" Padding="10">
            <ScrollViewer x:Name="OutputScroller"
                          VerticalScrollBarVisibility="Auto"
                          Background="#f5f5f5">
                <TextBlock Text="{Binding OutputLog}"
                           FontFamily="Consolas" FontSize="9"
                           TextWrapping="Wrap" Padding="4"/>
            </ScrollViewer>
        </GroupBox>
        </Grid>
    </Grid>
</Window>
